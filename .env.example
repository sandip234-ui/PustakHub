# PustakHub — Environment Configuration Template
#
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to version control.
# NEVER place real production secrets in this file.

# --- Application ---
APP_NAME=PustakHub
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pustakhub

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Secrets ---
# Generate high-entropy keys with: openssl rand -hex 32
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MFA Encryption (AES-256-GCM) ---
# 32-byte (64 hex characters) key for encrypting TOTP secrets at rest in PostgreSQL
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- OTP ---
OTP_EXPIRE_MINUTES=5
MAX_OTP_ATTEMPTS=5

# --- SMTP / Email Notifications ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASSWORD=smtp-password
SMTP_FROM=noreply@pustakhub.com
SMTP_FROM_NAME=PustakHub
SMTP_USE_TLS=true

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_REQUESTS=20
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_PASSWORD_RESET_REQUESTS=20
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=60
RATE_LIMIT_MFA_REQUESTS=20
RATE_LIMIT_MFA_WINDOW_SECONDS=60
RATE_LIMIT_API_REQUESTS=200
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_CLOSED_AUTH=true

# --- Security Hardening & Headers ---
MAX_REQUEST_BODY_SIZE=2097152
ENABLE_SECURITY_HEADERS=true
ENABLE_CSP=true
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# --- Circulation Policy Defaults ---
DEFAULT_LOAN_PERIOD_DAYS=14
DAILY_FINE_RATE=2.00
MAX_ACTIVE_BORROWS_PER_USER=5
