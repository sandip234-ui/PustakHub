# PustakHub Backend — Environment Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER place real secrets in this file.

# --- Application ---
APP_NAME=PustakHub
APP_VERSION=0.1.0
DEBUG=false

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS & Frontend ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5174

# --- Database (Phase 2) ---
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>

# --- Redis (Phase 3) ---
# REDIS_URL=redis://localhost:6379/0

# --- JWT (Phase 3) ---
# JWT_SECRET=<generate with: openssl rand -hex 32>
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cryptography & MFA (Phase 9) ---
# MFA_ENCRYPTION_KEY=<generate with: openssl rand -hex 32> (Required in production)

# --- OTP (Phase 3) ---
# OTP_EXPIRE_MINUTES=5
# MAX_OTP_ATTEMPTS=5

# --- SMTP (Phase 3) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=smtp-user
# SMTP_PASSWORD=smtp-password
# SMTP_FROM=noreply@pustakhub.com
# SMTP_FROM_NAME=PustakHub
# SMTP_USE_TLS=true

# --- Rate Limiting (Phase 8) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_REQUESTS=20
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_PASSWORD_RESET_REQUESTS=20
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=60
RATE_LIMIT_MFA_REQUESTS=20
RATE_LIMIT_MFA_WINDOW_SECONDS=60
RATE_LIMIT_API_REQUESTS=200
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_CLOSED_AUTH=true

# --- Security Hardening & Headers (Phase 8) ---
MAX_REQUEST_BODY_SIZE=2097152
ENABLE_SECURITY_HEADERS=true
ENABLE_CSP=true
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
ENVIRONMENT=development
